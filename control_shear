import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import solve_banded

# ============================================================
# PARAMETERS
# ============================================================

L = 1.0
T = 10.0

Nx = 200
Nt = 6250

dx = L / Nx
dt = T / Nt

x = np.linspace(0.0, L, Nx + 1)
t = np.linspace(0.0, T, Nt + 1)

kappa = 5.0 / 6.0

ell = 0.0508
h_beam = 0.0031
A = ell * h_beam
rho = 2770.0
rho1 = rho * A

alpha = 1.0e1
mu1 = 1.0
mu2 = 1.0

max_iter = 80
tol_grad = 1.0e-6
eta = 1.0 / alpha
omega = 0.5

use_relaxed_fixed_point = True

# CFL check
c_eff = np.sqrt(kappa / rho1)
cfl = dt / dx * c_eff

print(f"rho1 = {rho1:.6e}")
print(f"dx   = {dx:.6e}")
print(f"dt   = {dt:.6e}")
print(f"CFL  = {cfl:.6e}")

if cfl >= 1.0:
    print("WARNING: CFL condition may be violated.")


# ============================================================
# BUILD ELLIPTIC MATRIX FOR psi OR q
# ============================================================

def build_elliptic_banded(Nx, dx, kappa):
    """
    Builds banded matrix for the compatible elliptic discretization.

    Unknowns: psi_0, ..., psi_Nx.
    Matrix size: (Nx+1) x (Nx+1).

    Returns ab for scipy.linalg.solve_banded((1,1), ab, rhs).
    """

    N = Nx + 1
    ab = np.zeros((3, N))

    # Left boundary row
    # (-1/dx - k dx/4) psi_0 + (1/dx - k dx/4) psi_1 = rhs
    ab[1, 0] = -1.0 / dx - kappa * dx / 4.0
    ab[0, 1] =  1.0 / dx - kappa * dx / 4.0

    # Interior rows
    lower = -1.0 / dx**2 + kappa / 4.0
    diag  =  2.0 / dx**2 + kappa / 2.0
    upper = -1.0 / dx**2 + kappa / 4.0

    for j in range(1, Nx):
        ab[2, j - 1] = lower
        ab[1, j]     = diag
        ab[0, j + 1] = upper

    # Right boundary row
    # (-1/dx + k dx/4) psi_{N-1} + (1/dx + k dx/4) psi_N = rhs
    ab[2, Nx - 1] = -1.0 / dx + kappa * dx / 4.0
    ab[1, Nx]     =  1.0 / dx + kappa * dx / 4.0

    return ab


A_banded = build_elliptic_banded(Nx, dx, kappa)


# ============================================================
# ELLIPTIC SOLVER
# ============================================================

def solve_elliptic(phi, u_value, controlled=True):
    """
    Solves the elliptic equation for psi:
        -psi_xx + kappa(phi_x + psi) = 0

    If controlled=True, boundary RHS contains u_value.
    If controlled=False, homogeneous adjoint boundary condition is used.
    """

    rhs = np.zeros(Nx + 1)

    # Interior nodes
    for j in range(1, Nx):
        rhs[j] = -kappa * (phi[j + 1] - phi[j - 1]) / (2.0 * dx)

    # Boundary conditions
    if controlled:
        rhs[0] = u_value + (kappa / 2.0) * (phi[1] - phi[0])
        rhs[Nx] = u_value - (kappa / 2.0) * (phi[Nx] - phi[Nx - 1])
    else:
        rhs[0] = (kappa / 2.0) * (phi[1] - phi[0])
        rhs[Nx] = -(kappa / 2.0) * (phi[Nx] - phi[Nx - 1])

    return solve_banded((1, 1), A_banded, rhs)


# ============================================================
# INITIAL CONDITIONS
# ============================================================

def phi0_function(x):
    # Option 1: energy validation
    return np.sin(np.pi * x)

    # Option 2: localized perturbation
    # return 0.5 * np.exp(-200.0 * (x - 0.4)**2)


def phi1_function(x):
    return np.zeros_like(x)


# ============================================================
# STATE SOLVER
# ============================================================

def solve_state(u):
    """
    Forward solve of the state system for a given control u[n].
    """

    phi = np.zeros((Nt + 1, Nx + 1))
    psi = np.zeros((Nt + 1, Nx + 1))

    phi[0, :] = phi0_function(x)
    phi[0, 0] = 0.0
    phi[0, -1] = 0.0

    psi[0, :] = solve_elliptic(phi[0, :], u[0], controlled=True)

    # Initial acceleration
    acc0 = np.zeros(Nx + 1)
    for j in range(1, Nx):
        acc0[j] = (kappa / rho1) * (
            (phi[0, j + 1] - 2.0 * phi[0, j] + phi[0, j - 1]) / dx**2
            +
            (psi[0, j + 1] - psi[0, j - 1]) / (2.0 * dx)
        )

    phi_minus = phi[0, :] - dt * phi1_function(x) + 0.5 * dt**2 * acc0
    phi_minus[0] = 0.0
    phi_minus[-1] = 0.0

    previous = phi_minus.copy()

    for n in range(0, Nt):
        psi[n, :] = solve_elliptic(phi[n, :], u[n], controlled=True)

        next_phi = np.zeros(Nx + 1)

        for j in range(1, Nx):
            next_phi[j] = (
                2.0 * phi[n, j]
                - previous[j]
                + (kappa * dt**2 / rho1)
                * (
                    (phi[n, j + 1] - 2.0 * phi[n, j] + phi[n, j - 1]) / dx**2
                    +
                    (psi[n, j + 1] - psi[n, j - 1]) / (2.0 * dx)
                )
            )

        next_phi[0] = 0.0
        next_phi[-1] = 0.0

        if n < Nt:
            previous = phi[n, :].copy()
            if n + 1 <= Nt:
                phi[n + 1, :] = next_phi

    psi[Nt, :] = solve_elliptic(phi[Nt, :], u[Nt], controlled=True)

    return phi, psi


# ============================================================
# ADJOINT SOLVER
# ============================================================

def solve_adjoint(phi):
    """
    Backward solve of the adjoint system using terminal PMP conditions.
    """

    p = np.zeros((Nt + 2, Nx + 1))
    q = np.zeros((Nt + 1, Nx + 1))

    # Terminal velocity approximation of state
    #phi_t_T = (phi[Nt, :] - phi[Nt - 1, :]) / dt
    phi_t_T = (
    3.0 * phi[Nt, :]
    - 4.0 * phi[Nt - 1, :]
    + phi[Nt - 2, :]
) / (2.0 * dt)

    # Terminal condition
    p[Nt, :] = -(mu2 / rho1) * phi_t_T
    p[Nt, 0] = 0.0
    p[Nt, -1] = 0.0

    q[Nt, :] = solve_elliptic(p[Nt, :], 0.0, controlled=False)

    # Artificial terminal level p^{N+1}
    p_t_T = (mu1 / rho1) * phi[Nt, :]

    acc_T = np.zeros(Nx + 1)
    for j in range(1, Nx):
        acc_T[j] = (kappa / rho1) * (
            (p[Nt, j + 1] - 2.0 * p[Nt, j] + p[Nt, j - 1]) / dx**2
            +
            (q[Nt, j + 1] - q[Nt, j - 1]) / (2.0 * dx)
        )

    p[Nt + 1, :] = p[Nt, :] + dt * p_t_T + 0.5 * dt**2 * acc_T
    p[Nt + 1, 0] = 0.0
    p[Nt + 1, -1] = 0.0

    # Backward time integration
    for n in range(Nt, 0, -1):
        q[n, :] = solve_elliptic(p[n, :], 0.0, controlled=False)

        p_prev = np.zeros(Nx + 1)

        for j in range(1, Nx):
            p_prev[j] = (
                2.0 * p[n, j]
                - p[n + 1, j]
                + (kappa * dt**2 / rho1)
                * (
                    (p[n, j + 1] - 2.0 * p[n, j] + p[n, j - 1]) / dx**2
                    +
                    (q[n, j + 1] - q[n, j - 1]) / (2.0 * dx)
                )
            )

        p_prev[0] = 0.0
        p_prev[-1] = 0.0
        p[n - 1, :] = p_prev

    q[0, :] = solve_elliptic(p[0, :], 0.0, controlled=False)

    return p[:Nt + 1, :], q


# ============================================================
# DISCRETE COST FUNCTIONAL
# ============================================================

def compute_cost(phi, u):
    phi_T = phi[Nt, :]
    #phi_t_T = (phi[Nt, :] - phi[Nt - 1, :]) / dt
    phi_t_T = (
    3.0 * phi[Nt, :]
    - 4.0 * phi[Nt - 1, :]
    + phi[Nt - 2, :]
) / (2.0 * dt)

    terminal = 0.5 * dx * np.sum(mu1 * phi_T**2 + mu2 * phi_t_T**2)
    control = 0.5 * alpha * dt * np.sum(u**2)

    return terminal + control


# ============================================================
# DISCRETE ENERGY
# ============================================================

def compute_energy(phi, psi):
    E = np.zeros(Nt)

    for n in range(0, Nt):
        v = (phi[n + 1, :] - phi[n, :]) / dt

        kinetic = rho1 * np.sum(v[:-1]**2)

        psi_x_np1 = (psi[n + 1, 1:] - psi[n + 1, :-1]) / dx
        psi_x_n = (psi[n, 1:] - psi[n, :-1]) / dx

        shear_np1 = (
            (phi[n + 1, 1:] - phi[n + 1, :-1]) / dx
            +
            0.5 * (psi[n + 1, 1:] + psi[n + 1, :-1])
        )

        shear_n = (
            (phi[n, 1:] - phi[n, :-1]) / dx
            +
            0.5 * (psi[n, 1:] + psi[n, :-1])
        )

        elastic_psi = np.sum(psi_x_np1 * psi_x_n)
        elastic_shear = kappa * np.sum(shear_np1 * shear_n)

        E[n] = 0.5 * dx * (kinetic + elastic_psi + elastic_shear)

    return E


# ============================================================
# OPTIMIZATION LOOP
# ============================================================

u = np.zeros(Nt + 1)

cost_history = []
grad_history = []
control_diff_history = []

for k in range(max_iter):
    print(f"\nIteration {k + 1}/{max_iter}")

    phi, psi = solve_state(u)
    p, q = solve_adjoint(phi)

    grad = alpha * u - (q[:, -1] - q[:, 0])

    grad_norm = np.sqrt(dt * np.sum(grad**2))
    Jval = compute_cost(phi, u)

    cost_history.append(Jval)
    grad_history.append(grad_norm)

    print(f"J(u)       = {Jval:.8e}")
    print(f"||grad||   = {grad_norm:.8e}")

    if grad_norm < tol_grad:
        print("Convergence achieved.")
        break

    if use_relaxed_fixed_point:
        u_new = (1.0 - omega) * u + omega * (q[:, -1] - q[:, 0]) / alpha
    else:
        u_new = u - eta * grad

    control_diff = np.sqrt(dt * np.sum((u_new - u)**2))
    control_diff_history.append(control_diff)

    print(f"||du||      = {control_diff:.8e}")

    u = u_new.copy()


# Final solve
phi_opt, psi_opt = solve_state(u)
p_opt, q_opt = solve_adjoint(phi_opt)
E_opt = compute_energy(phi_opt, psi_opt)
# ============================================================
# CONTROLLED vs UNCONTROLLED COMPARISON
# ============================================================

# Uncontrolled solution: same initial conditions, u(t) = 0
u_zero = np.zeros(Nt + 1)

phi_free, psi_free = solve_state(u_zero)
E_free = compute_energy(phi_free, psi_free)


# ------------------------------------------------------------
# Auxiliary functions for quantitative comparison
# ------------------------------------------------------------

def l2_space(v):
    """
    Discrete L2(0,L) norm using the trapezoidal rule.
    """
    return np.sqrt(
        dx * (
            0.5 * v[0]**2
            + np.sum(v[1:-1]**2)
            + 0.5 * v[-1]**2
        )
    )


def terminal_velocity(phi):
    """
    Second-order backward approximation of phi_t(T).
    """
    return (
        3.0 * phi[Nt, :]
        - 4.0 * phi[Nt - 1, :]
        + phi[Nt - 2, :]
    ) / (2.0 * dt)


def terminal_cost(phi):
    """
    Terminal part of the objective functional.
    """
    phi_T = phi[Nt, :]
    phi_t_T = terminal_velocity(phi)

    return 0.5 * (
        mu1 * l2_space(phi_T)**2
        + mu2 * l2_space(phi_t_T)**2
    )


# Terminal quantities
phiT_free = phi_free[Nt, :]
phiT_opt  = phi_opt[Nt, :]

phi_tT_free = terminal_velocity(phi_free)
phi_tT_opt  = terminal_velocity(phi_opt)

norm_phi_free = l2_space(phiT_free)
norm_phi_opt  = l2_space(phiT_opt)

norm_vel_free = l2_space(phi_tT_free)
norm_vel_opt  = l2_space(phi_tT_opt)

JT_free = terminal_cost(phi_free)
JT_opt  = terminal_cost(phi_opt)

J_free = compute_cost(phi_free, u_zero)
J_opt  = compute_cost(phi_opt, u)


# Percentage reductions
def reduction_percentage(controlled, uncontrolled):
    if abs(uncontrolled) < 1.0e-14:
        return np.nan
    return 100.0 * (uncontrolled - controlled) / uncontrolled


red_phi = reduction_percentage(norm_phi_opt, norm_phi_free)
red_vel = reduction_percentage(norm_vel_opt, norm_vel_free)
red_JT  = reduction_percentage(JT_opt, JT_free)
red_E   = reduction_percentage(E_opt[-1], E_free[-1])


# ------------------------------------------------------------
# Print comparison
# ------------------------------------------------------------

print("\n" + "=" * 65)
print("CONTROLLED vs UNCONTROLLED COMPARISON")
print("=" * 65)

print(f"{'||phi(T)||_L2':30s} "
      f"uncontrolled = {norm_phi_free:.8e}   "
      f"controlled = {norm_phi_opt:.8e}   "
      f"reduction = {red_phi:.2f}%")

print(f"{'||phi_t(T)||_L2':30s} "
      f"uncontrolled = {norm_vel_free:.8e}   "
      f"controlled = {norm_vel_opt:.8e}   "
      f"reduction = {red_vel:.2f}%")

print(f"{'Terminal cost':30s} "
      f"uncontrolled = {JT_free:.8e}   "
      f"controlled = {JT_opt:.8e}   "
      f"reduction = {red_JT:.2f}%")

print(f"{'Final discrete energy':30s} "
      f"uncontrolled = {E_free[-1]:.8e}   "
      f"controlled = {E_opt[-1]:.8e}   "
      f"reduction = {red_E:.2f}%")

print(f"{'Total cost J':30s} "
      f"uncontrolled = {J_free:.8e}   "
      f"controlled = {J_opt:.8e}")

print("=" * 65)
